# seekdb / OceanBase MySQL protocol
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=sdd_minimax

# PowerContext HTTP (preferred for scoring)
POWERCONTEXT_BASE_URL=http://127.0.0.1:8000
POWERCONTEXT_MODE=http
POWERCONTEXT_SCOPE=minimax-sdd-demo

# MiniMax (required for scoring — do NOT commit real keys)
MINIMAX_API_KEY=YOUR_KEY_HERE
# CN: https://api.minimaxi.com/v1
# Global: https://api.minimax.io/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2
